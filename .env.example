# Luxury Tech — Next.js/Vercel server environment
# Configure values in Vercel Settings > Environment Variables. Never use NEXT_PUBLIC_ for secrets.
APP_ORIGIN=https://www.luxurytech.org
MONGODB_URI=
MONGODB_DB=LT_Proposals
# Salt:hash generated by ADMIN_PASSWORD=<strong password> npm run admin:password
ADMIN_PASSWORD_HASH=
# Generate 32 random bytes as hex; preserve securely for document decryption and evidence verification.
DATA_ENCRYPTION_KEY=
CRON_SECRET=
BINDING_SIGNATURES_ENABLED=false

# Email OTP and notifications. Use a newly issued app password or dedicated SMTP account.
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Meta-approved utility template with exactly one body parameter: the opaque contract ID.
META_SEND_ENABLED=false
META_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=he
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Required on Vercel: a pinned Linux x64 pack matching @sparticuz/chromium-min's major version.
CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v153.0.0/chromium-v153.0.0-pack.x64.tar

# Optional private S3-compatible object storage. Without this, encrypted PDFs live in MongoDB.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
